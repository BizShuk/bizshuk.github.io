      "due": { "months": [6], "day": 1 },
      "notes": "NACE 於畢業年度後隔年春末發布; NY Fed 的近期畢業生勞動市場資料為季更新, 可作補充."
    },
    {
      "id": "us_verify",
      "task": "verify",
      "country": "US",
      "title": "美國配對稽核",
      "due": { "months": [6], "day": 1 },
      "depends_on": ["us_collect"]
    },

    {
      "id": "jp_collect",
      "task": "collect",
