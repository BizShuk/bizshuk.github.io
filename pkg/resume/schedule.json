{
  "schema_version": 1,
  "cadence": "weekly",
  "period_scheme": "H",
  "start": "2026-01-01",

  "defaults": {
    "grace_days": 21,
    "backoff_days": [7, 7, 14, 28],
    "max_attempts": 8
  },

  "events": [
    {
      "id": "sg_collect",
      "task": "collect",
      "country": "SG",
      "title": "新加坡畢業生就業調查 (GES) 收集",
      "instrument": "Joint Autonomous Universities Graduate Employment Survey",
      "due": { "months": [3], "day": 1 },
      "notes": "MOE 與六所大學聯合發布, 通常落在 2 月下旬至 3 月上旬."
    },
    {
      "id": "sg_verify",
      "task": "verify",
      "country": "SG",
      "title": "新加坡配對稽核 (source pair audit)",
      "due": { "months": [3], "day": 1 },
      "depends_on": ["sg_collect"]
    },

    {
      "id": "us_collect",
      "task": "collect",
      "country": "US",
      "title": "美國 First-Destination Survey 收集",
