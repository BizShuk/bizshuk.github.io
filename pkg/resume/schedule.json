    {
      "id": "dataset_extract",
      "task": "extract",
      "country": null,
      "title": "全資料集展平為 tidy CSV",
      "due": { "per_period": true, "offset_days": 150 },
      "grace_days": 14,
      "backoff_days": [7],
      "max_attempts": 4,
      "notes": "期末統一執行, 不等待個別市場, 缺漏由 data_gap 欄位自行表達."
